{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/addpyun78/AndroidAW/schemas/tool-policy.schema.json",
  "title": "KH_Aw physical tool policy",
  "type": "object",
  "required": ["schemaVersion", "targetPipeline", "apkInstallation", "requiredTools", "configuration"],
  "properties": {
    "schemaVersion": {"const": "3.0"},
    "targetPipeline": {"enum": ["web-responsive", "app-mobile-webview", "android-native", "ios-native", "cross-platform"]},
    "apkInstallation": {
      "type": "object",
      "required": ["status", "forbiddenCommands"],
      "properties": {
        "status": {"const": "forbidden"},
        "forbiddenCommands": {"type": "array", "minItems": 5, "items": {"type": "string"}}
      }
    },
    "requiredTools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "required", "kind"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "kind": {"type": "string", "minLength": 1}
        }
      }
    },
    "configuration": {"type": "object", "required": ["commands"]}
  },
  "additionalProperties": true
}
